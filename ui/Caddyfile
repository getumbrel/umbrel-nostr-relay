:3000 {
	root * /app/build
	encode gzip
	# HTML and NIP-11 JSON share a URL but must have separate browser cache entries.
	header +Vary Accept

	@websockets {
		# Connection tokens are case-insensitive; Node's WebSocket sends lowercase.
		header_regexp Connection (?i)upgrade
		header Upgrade    websocket
	}

	@nostr {
		header Accept application/nostr+json
	}

	@relayproxy {
    path /relay-proxy/*
  }
	
	reverse_proxy @websockets {$RELAY_HOST}:{$RELAY_PORT} {
		# The engine uses HTTP/1.1 WebSockets; keep its legacy HTTP/2 stack off this path.
		transport http {
			versions 1.1
		}
	}
	reverse_proxy @nostr {$RELAY_HOST}:{$RELAY_PORT} {
		# The engine uses HTTP/1.1 WebSockets; keep its legacy HTTP/2 stack off this path.
		transport http {
			versions 1.1
		}
	}
	reverse_proxy @relayproxy {$RELAY_PROXY_HOST}:{$RELAY_PROXY_PORT}
	
	file_server

	log {
		output stdout
	}
}
